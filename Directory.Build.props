<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.1</Version>
    <Company>ApkInfos</Company>
    <Product>ApkInfos</Product>
    <Authors>Wade.liuyu (meleke_ly@126.com)</Authors>
    <Copyright>Copyright © 2026 Wade.liuyu</Copyright>
    <RepositoryUrl>https://github.com/meleke/ApkInfos</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>
</Project>
