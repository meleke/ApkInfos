<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ApkInfos.App.ManifestWindow"
        Title="AndroidManifest.xml"
        Icon="/Assets/app.ico"
        Width="960" Height="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, PingFang SC, Segoe UI, Helvetica Neue">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="AnnotateCheck" Content="中文注解" IsChecked="True"
                          IsCheckedChanged="OnAnnotateChanged" />
                <Button Content="复制全部" Click="OnCopyClick" />
                <Button Content="另存为…" Click="OnSaveClick" />
                <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>
        </Border>
        <TextBox x:Name="XmlBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, Consolas, Menlo, Monaco, monospace"
                 FontSize="13"
                 Margin="8"
                 VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
